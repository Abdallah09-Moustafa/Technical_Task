<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="product_template_form_view_rop_inherit" model="ir.ui.view">
            <field name="name">product.template.form.rop.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <!-- Smart Button in Button Box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button"
                            type="object"
                            name="action_view_same_rop_products"
                            icon="fa-cubes"
                            invisible="not has_rop or rop_count == 0">
                        <field string="Same ROP Count" name="same_rop_count" widget="statinfo"/>
                    </button>
                </xpath>

                <!-- ROP Fields in General Info -->
                <xpath expr="//group[@name='group_general']" position="inside">
                    <field name="has_rop"/>
                    <field name="rop_count" invisible="not has_rop"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
