<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="view_update_product_qty_wizard_form" model="ir.ui.view">
            <field name="name">update.product.qty.wizard.form</field>
            <field name="model">update.product.qty.wizard</field>
            <field name="arch" type="xml">
                <form string="Update Product Quantity">
                    <group>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="current_qty"/>
                        <field name="new_quantity"/>
                    </group>
                    <footer>
                        <button name="action_update_quantity" string="Apply Quantity" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_update_product_qty_wizard" model="ir.actions.act_window">
            <field name="name">Update Product Quantity</field>
            <field name="res_model">update.product.qty.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_view_types">form</field>
        </record>

    </data>
</odoo>
